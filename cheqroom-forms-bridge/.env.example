PORT=3000

# Staff enter this on the Render approval page. Use a long random value.
WEBHOOK_SECRET=replace-with-a-long-random-secret

# Cheqroom credentials. Put real values only in Render environment variables.
CHEQROOM_BASE_URL=https://app.cheqroom.com/api/v2_5
CHEQROOM_WORKSPACE=uark
CHEQROOM_API_KEY=replace-with-cheqroom-api-key
CHEQROOM_LINKED_USER_ID=replace-with-linked-user-id

# Matches the working UARK inventory export scripts:
# https://app.cheqroom.com/api/v2_5/{linkedUserId}/null/jwt + Authorization: Bearer API_KEY
CHEQROOM_AUTH_STYLE=linked-user-bearer
CHEQROOM_TOKEN_TYPE=null

# Cheqroom user creation fields.
CHEQROOM_ROLE=selfservice
CHEQROOM_INVITE=true
CHEQROOM_CREATE_CUSTOMER=true

# Keep 0 for staff-reviewed manual approvals. Set to 34 only if score is always sent.
MIN_SCORE=0
ALLOWED_EMAIL_DOMAIN=uark.edu
